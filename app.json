{
  "expo": {
    "name": "CHI",
    "slug": "chi-demo",
    "version": "1.0.0",
    "scheme": "chi",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock your CHI member area with Face ID.",
        "NSLocationWhenInUseUsageDescription": "Used to point the Qibla compass towards Makkah."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF6EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF6EE",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-local-authentication",
      "expo-location"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
